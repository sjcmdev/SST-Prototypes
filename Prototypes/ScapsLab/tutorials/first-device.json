{
  "schema_version": 1,
  "id": "first-device",
  "title": "First device",
  "description": "Create a device, add a second layer, calculate a dark I-V curve and read its band diagram.",
  "minutes": 4,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device in the Project tree, then name the device Tutorial: First device.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: First device"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: First device"
      },
      "timeout_s": 120
    },
    {
      "id": "add-layer",
      "target": {
        "window": "scapslab.Layers",
        "item": "add-layer"
      },
      "instruction": "In Layers click Add. A solar cell needs at least two layers (for example p and n).",
      "command": {
        "operation": "layer",
        "action": "add"
      },
      "condition": {
        "predicate": "device.layer_count",
        "op": "ge",
        "value": 2
      },
      "timeout_s": 120
    },
    {
      "id": "dark-iv",
      "target": {
        "window": "scapslab.Run",
        "item": "run"
      },
      "instruction": "In Run click Calculate I-V and wait for the I-V curve.",
      "command": {
        "operation": "run"
      },
      "condition": {
        "predicate": "result.iv.valid",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    },
    {
      "id": "bands",
      "target": {
        "window": "scapslab.Band diagram & profiles"
      },
      "instruction": "Open Band diagram & profiles. Move the Bias point slider and watch Ec, Ev and the Fermi levels change. Press Next.",
      "command": {
        "operation": "inspect"
      },
      "condition": {
        "predicate": "result.iv.valid",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    }
  ]
}
