{
  "schema_version": 1,
  "id": "generation-from-file",
  "title": "Generation G(x) from a .gen file",
  "description": "Use a measured generation profile G(x) from a .gen file.",
  "minutes": 3,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device at the top of the Project tree and name the device Tutorial: G(x) from file.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: G(x) from file",
        "example": "08-pn-illumination.yaml"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: G(x) from file"
      },
      "timeout_s": 120
    },
    {
      "id": "load-gen",
      "target": {
        "window": "scapslab.Illumination",
        "item": "source"
      },
      "instruction": "In Illumination choose Generation profile from file and load examples/profiles/generation.gen. The preview shows G [cm^-3 s^-1] versus x [nm].",
      "command": {
        "operation": "load_profile",
        "parameter_id": "generation_m3_s",
        "profile_example": "generation.gen"
      },
      "condition": {
        "predicate": "illumination.generation_file",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    },
    {
      "id": "light-iv",
      "target": {
        "window": "scapslab.Run",
        "item": "run"
      },
      "instruction": "In Run include I-V and click Single shot. The result uses your G(x).",
      "command": {
        "operation": "run"
      },
      "condition": {
        "predicate": "result.iv.valid",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    }
  ]
}
