{
  "schema_version": 1,
  "id": "light-iv-qe",
  "title": "Light I-V and QE",
  "description": "Illuminate a p-n cell, read Voc, Jsc and FF, then calculate QE.",
  "minutes": 5,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device at the top of the Project tree and name the device Tutorial: Light I-V and QE. Your other devices stay in the project.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Light I-V and QE"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Light I-V and QE"
      },
      "timeout_s": 120
    },
    {
      "id": "illumination",
      "target": {
        "window": "scapslab.Illumination"
      },
      "instruction": "In Illumination tick Light enabled (or import the 08-pn-illumination example as a device).",
      "command": {
        "operation": "edit",
        "example": "08-pn-illumination.yaml"
      },
      "condition": {
        "predicate": "device.light",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    },
    {
      "id": "light-iv",
      "target": {
        "window": "scapslab.Illumination",
        "item": "light-iv"
      },
      "instruction": "On Light I-V click Calculate light I-V. A working solar cell has positive Voc, Jsc and FF.",
      "command": {
        "operation": "run"
      },
      "condition": {
        "predicate": "result.iv.Voc_V",
        "op": "gt",
        "value": 0.0
      },
      "timeout_s": 120
    },
    {
      "id": "jsc",
      "target": {
        "window": "scapslab.Illumination"
      },
      "instruction": "Look at Jsc [A/m^2], the short-circuit current density. It should be positive.",
      "command": {
        "operation": "inspect"
      },
      "condition": {
        "predicate": "result.iv.Jsc_A_m2",
        "op": "gt",
        "value": 0.0
      },
      "timeout_s": 120
    },
    {
      "id": "ff",
      "target": {
        "window": "scapslab.Illumination"
      },
      "instruction": "Look at FF [fraction], the fill factor. It should be positive.",
      "command": {
        "operation": "inspect"
      },
      "condition": {
        "predicate": "result.iv.FF_fraction",
        "op": "gt",
        "value": 0.0
      },
      "timeout_s": 120
    },
    {
      "id": "qe",
      "target": {
        "window": "scapslab.Illumination",
        "item": "qe"
      },
      "instruction": "On QE(lambda) set 590 to 610 nm with 3 points and click Calculate QE. Check EQE and the integrated Jsc.",
      "command": {
        "operation": "qe",
        "start_nm": 590.0,
        "stop_nm": 610.0,
        "points": 3
      },
      "condition": {
        "predicate": "result.qe.valid",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    }
  ]
}
