{
  "schema_version": 1,
  "id": "table-undo-redo",
  "title": "Undo and Redo of a table edit",
  "description": "Undo and redo a loaded table; every device has its own history.",
  "minutes": 3,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Devices",
        "item": "new"
      },
      "instruction": "In Devices click New (template) and name the device: Tutorial: Undo and Redo.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Undo and Redo",
        "example": "08-pn-illumination.yaml"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Undo and Redo"
      },
      "timeout_s": 120
    },
    {
      "id": "load-table",
      "target": {
        "window": "scapslab.Grading",
        "item": "parameter"
      },
      "instruction": "In Grading choose Na_m3, tick Grade parameter and load examples/profiles/doping.grd with From file.",
      "command": {
        "operation": "load_profile",
        "layer_id": "layer-1",
        "parameter_id": "Na_m3",
        "profile_example": "doping.grd"
      },
      "condition": {
        "predicate": "grading.law",
        "op": "eq",
        "value": "table"
      },
      "timeout_s": 120
    },
    {
      "id": "undo",
      "target": {
        "window": "scapslab.Project",
        "item": "undo"
      },
      "instruction": "Press Undo in Project (or Edit > Undo). The table disappears.",
      "command": {
        "operation": "undo"
      },
      "condition": {
        "predicate": "grading.law",
        "op": "eq",
        "value": ""
      },
      "timeout_s": 120
    },
    {
      "id": "redo",
      "target": {
        "window": "scapslab.Project",
        "item": "redo"
      },
      "instruction": "Press Redo (or Edit > Redo). The table comes back.",
      "command": {
        "operation": "redo"
      },
      "condition": {
        "predicate": "grading.law",
        "op": "eq",
        "value": "table"
      },
      "timeout_s": 120
    }
  ]
}
