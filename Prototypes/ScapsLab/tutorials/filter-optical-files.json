{
  "schema_version": 1,
  "id": "filter-optical-files",
  "title": "Filters .ftr and optical capture .opt",
  "description": "Load a front filter (.ftr) and a defect optical capture file (.opt).",
  "minutes": 3,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device at the top of the Project tree and name the device Tutorial: Filter and capture.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Filter and capture",
        "example": "08-pn-illumination.yaml",
        "patches": [
          "defect"
        ]
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Filter and capture"
      },
      "timeout_s": 120
    },
    {
      "id": "filter",
      "target": {
        "window": "scapslab.Illumination",
        "item": "front_filter_file"
      },
      "instruction": "In Illumination press Browse next to Front transmission [.ftr] and load examples/profiles/filter.ftr (nm, percent).",
      "command": {
        "operation": "edit",
        "example": "08-pn-illumination.yaml",
        "patches": [
          "defect",
          "filter.ftr"
        ]
      },
      "condition": {
        "predicate": "illumination.filter_points",
        "op": "eq",
        "value": 3
      },
      "timeout_s": 120
    },
    {
      "id": "capture",
      "target": {
        "window": "scapslab.Defects",
        "item": "optical-capture"
      },
      "instruction": "In Defects open Optical capture / IPV, tick Enabled and load examples/profiles/capture.opt as Electron capture (nm, m^2).",
      "command": {
        "operation": "edit",
        "example": "08-pn-illumination.yaml",
        "patches": [
          "defect",
          "filter.ftr",
          "capture.opt"
        ]
      },
      "condition": {
        "predicate": "defect.optical_points",
        "op": "eq",
        "value": 3
      },
      "timeout_s": 120
    }
  ]
}
