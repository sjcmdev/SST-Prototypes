{
  "schema_version": 1,
  "id": "load-grading-profile",
  "title": "Load a grading profile from file",
  "description": "Load a doping profile Na(x) from a .grd file.",
  "minutes": 3,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device at the top of the Project tree and name the device Tutorial: Grading profile.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Grading profile"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Grading profile"
      },
      "timeout_s": 120
    },
    {
      "id": "load-profile",
      "target": {
        "window": "scapslab.Grading",
        "item": "parameter"
      },
      "instruction": "In Grading select layer 1 and Na_m3, tick Grade parameter, choose From file and load examples/profiles/doping.grd. The preview shows x [nm] and density [cm^-3].",
      "command": {
        "operation": "load_profile",
        "layer_id": "layer-1",
        "parameter_id": "Na_m3",
        "profile_example": "doping.grd"
      },
      "condition": {
        "predicate": "profile.loaded",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    }
  ]
}
