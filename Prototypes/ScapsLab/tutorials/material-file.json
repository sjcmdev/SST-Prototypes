{
  "schema_version": 1,
  "id": "material-file",
  "title": "Save and load a .material file",
  "description": "Save a layer as a SCAPS .material file and load it back.",
  "minutes": 3,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Project",
        "item": "new"
      },
      "instruction": "Click New device at the top of the Project tree and name the device Tutorial: Material file.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Material file",
        "example": "08-pn-illumination.yaml"
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Material file"
      },
      "timeout_s": 120
    },
    {
      "id": "save",
      "target": {
        "window": "scapslab.Layers",
        "item": "material-save"
      },
      "instruction": "In Layers press Save... next to SCAPS material [.material] to store layer 1 (choose Both A/B).",
      "command": {
        "operation": "save_material",
        "layer_id": "layer-1",
        "selection": "both",
        "export_target": "scapslab-tutorial.material"
      },
      "condition": {
        "predicate": "material.file_exists",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    },
    {
      "id": "edit",
      "target": {
        "window": "scapslab.Layers",
        "item": "material-load"
      },
      "instruction": "In the Layers material table change the band gap Eg to 1.5 eV.",
      "command": {
        "operation": "edit",
        "example": "08-pn-illumination.yaml",
        "patches": [
          "eg-1.5"
        ]
      },
      "condition": {
        "predicate": "layer.Eg_eV",
        "op": "eq",
        "value": 1.5
      },
      "timeout_s": 120
    },
    {
      "id": "load",
      "target": {
        "window": "scapslab.Layers",
        "item": "material-load"
      },
      "instruction": "Press Load... and choose the .material file you saved. Eg returns to 1.12 eV; one Undo brings back 1.5 eV.",
      "command": {
        "operation": "load_material",
        "layer_id": "layer-1",
        "selection": "both",
        "path_target": "scapslab-tutorial.material"
      },
      "condition": {
        "predicate": "layer.Eg_eV",
        "op": "eq",
        "value": 1.12
      },
      "timeout_s": 120
    }
  ]
}
