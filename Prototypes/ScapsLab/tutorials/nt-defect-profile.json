{
  "schema_version": 1,
  "id": "nt-defect-profile",
  "title": "Defect profile Nt(x): Gauss, erfc, file",
  "description": "Give a defect a depth profile Nt(x): Gauss, erfc or from a file.",
  "minutes": 4,
  "steps": [
    {
      "id": "new-device",
      "target": {
        "window": "scapslab.Devices",
        "item": "new"
      },
      "instruction": "In Devices click New (template) and name the device: Tutorial: Nt(x) profile.",
      "command": {
        "operation": "device_add",
        "name": "Tutorial: Nt(x) profile",
        "example": "08-pn-illumination.yaml",
        "patches": [
          "defect"
        ]
      },
      "condition": {
        "predicate": "device.name",
        "op": "eq",
        "value": "Tutorial: Nt(x) profile"
      },
      "timeout_s": 120
    },
    {
      "id": "gauss",
      "target": {
        "window": "scapslab.Defects",
        "item": "diffusion-gauss"
      },
      "instruction": "In Defects select the defect, tick Spatial Nt(x) and press Gauss under Diffusion law. The preview shows Nt(x) in cm^-3.",
      "command": {
        "operation": "set_profile",
        "layer_id": "layer-1",
        "parameter_id": "Nt_m3",
        "defect_id": "defect-1-1",
        "profile": {
          "law": "gauss_diffusion",
          "diffusion_depth_m": -1e-06,
          "projected_range_m": 0.0,
          "dose_m2": 100000000000000.0
        }
      },
      "condition": {
        "predicate": "defect.law",
        "op": "eq",
        "value": "gauss_diffusion"
      },
      "timeout_s": 120
    },
    {
      "id": "erfc",
      "target": {
        "window": "scapslab.Defects",
        "item": "diffusion-erfc"
      },
      "instruction": "Press erfc under Diffusion law and compare the preview with the Gauss shape.",
      "command": {
        "operation": "set_profile",
        "layer_id": "layer-1",
        "parameter_id": "Nt_m3",
        "defect_id": "defect-1-1",
        "profile": {
          "law": "erfc_diffusion",
          "diffusion_depth_m": -1e-06,
          "surface_density_m3": 1e+20
        }
      },
      "condition": {
        "predicate": "defect.law",
        "op": "eq",
        "value": "erfc_diffusion"
      },
      "timeout_s": 120
    },
    {
      "id": "from-file",
      "target": {
        "window": "scapslab.Defects",
        "item": "law"
      },
      "instruction": "Under Profile law choose From file and load examples/profiles/defects.grd. Undo returns to the previous law.",
      "command": {
        "operation": "load_profile",
        "layer_id": "layer-1",
        "parameter_id": "Nt_m3",
        "defect_id": "defect-1-1",
        "profile_example": "defects.grd"
      },
      "condition": {
        "predicate": "defect.profile_file",
        "op": "eq",
        "value": true
      },
      "timeout_s": 120
    }
  ]
}
